{
  "name": "@zhangcun123/ontology",
  "version": "0.1.29",
  "description": "Schema-driven ontology engine for DeepWork: declare an enterprise world once, and derive the agent's tool surface and permissions from it.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/types/engine/graph.d.ts",
      "default": "./lib/engine/graph.js"
    },
    "./engine/schema": {
      "types": "./lib/types/engine/schema.d.ts",
      "default": "./lib/engine/schema.js"
    },
    "./tools": {
      "types": "./lib/types/tools/derive.d.ts",
      "default": "./lib/tools/derive.js"
    },
    "./tools/write": {
      "types": "./lib/types/tools/write.d.ts",
      "default": "./lib/tools/write.js"
    },
    "./tools/register": {
      "types": "./lib/types/tools/register.d.ts",
      "default": "./lib/tools/register.js"
    },
    "./govern/permission": {
      "types": "./lib/types/govern/permission.d.ts",
      "default": "./lib/govern/permission.js"
    },
    "./govern/audit": {
      "types": "./lib/types/govern/audit.d.ts",
      "default": "./lib/govern/audit.js"
    },
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "examples/**",
    "client/**"
  ],
  "engines": {
    "dsh": "^0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "author": "zhangcun1995521",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangcun1995521/deepwork.git",
    "directory": "packages/ontology"
  },
  "homepage": "https://github.com/zhangcun1995521/deepwork",
  "bugs": {
    "url": "https://github.com/zhangcun1995521/deepwork/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ontology",
    "agent",
    "governance",
    "permissions",
    "audit"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
