{
  "name": "@zhangcun123/external",
  "version": "0.1.0",
  "description": "Reach an outside system by the route the deployment's own domain declares — a capability plugin for DeepWork.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "built:domain": "npm run build --prefix ../ontology",
    "pretest": "npm run built:domain",
    "test": "node --test",
    "prebuild": "npm run built:domain",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run built:domain && tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@zhangcun123/ontology": "file:../ontology"
  },
  "author": "zhangcun1995521",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangcun1995521/deepwork.git",
    "directory": "packages/external"
  },
  "homepage": "https://github.com/zhangcun1995521/deepwork",
  "bugs": {
    "url": "https://github.com/zhangcun1995521/deepwork/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ontology",
    "connector",
    "external-system",
    "governance"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
